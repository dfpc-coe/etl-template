{
    "version": "1.0",
    "name": "ETL Template",
    "description": "Template ETL - update this description to reflect the data source this task ingests.",
    "compute": {
        "memory": 512,
        "timeout": 60
    },
    "permissions": [
        {
            "resource": "feature:*",
            "required": true,
            "description": "Posts features to the map"
        }
    ],
    "invocations": {
        "incoming": {
            "schedule": {
                "description": "Polls the upstream data source on a schedule.",
                "default": {
                    "enabled": true,
                    "schedule": "rate(1 minute)"
                }
            }
        }
    }
}
